fn f0<'a>(x: &'a i32, y: &'a mut i32) -> &'a i32 {
    let mut c: i32 = 0;
    while c < 3 {
        *y = *y + 1;
        c = c + 1;
    };
    if *x > *y {
        x
    } else {
        x
    }
}

